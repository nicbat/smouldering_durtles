<resources>
    <attr name="smokyModernDashboard" format="boolean"/>
    <style name="SmokyDashboardTheme" parent="SmokyMaterialTheme">
        <item name="smokyModernDashboard">true</item>
        <!-- Keep legacy button saved-state types stable when switching back to Classic. -->
        <item name="viewInflaterClass">androidx.appcompat.app.AppCompatViewInflater</item>
        <item name="buttonStyle">@style/Widget.AppCompat.Button</item>
        <item name="colorBackground">?attr/colorSurface</item>
        <item name="tileColorBackground">?attr/colorSurfaceContainerLow</item>
        <item name="toolbarColorBackground">?attr/colorSurface</item>
        <item name="colorPrimaryTonedDown">?attr/colorOutlineVariant</item>
        <item name="colorWaterfallLine">?attr/colorPrimary</item>
        <item name="colorLevelProgressTarget">?attr/colorOnSurface</item>
        <item name="smokySettingsToolbarTheme">@style/ThemeOverlay.Material3.Toolbar.Surface</item>
    </style>

    <!-- A complete popup theme also works above legacy AppCompat activities. -->
    <style name="SmokyOverflowTheme" parent="SmokyMaterialTheme">
        <item name="popupMenuStyle">@style/SmokyOverflowMenu</item>
        <item name="actionOverflowMenuStyle">@style/SmokyOverflowMenu</item>
        <item name="listPopupWindowStyle">@style/SmokyOverflowMenu</item>
        <item name="dropDownListViewStyle">@style/SmokyOverflowList</item>
        <item name="textAppearanceLargePopupMenu">@style/SmokyOverflowText</item>
        <item name="textAppearanceSmallPopupMenu">@style/SmokyOverflowText</item>
        <item name="listPreferredItemHeightSmall">48dp</item>
        <item name="listPreferredItemPaddingLeft">16dp</item>
        <item name="listPreferredItemPaddingRight">16dp</item>
    </style>
    <style name="SmokyOverflowDynamicTheme" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="popupMenuStyle">@style/SmokyOverflowMenu</item>
        <item name="actionOverflowMenuStyle">@style/SmokyOverflowMenu</item>
        <item name="listPopupWindowStyle">@style/SmokyOverflowMenu</item>
        <item name="dropDownListViewStyle">@style/SmokyOverflowList</item>
        <item name="textAppearanceLargePopupMenu">@style/SmokyOverflowText</item>
        <item name="textAppearanceSmallPopupMenu">@style/SmokyOverflowText</item>
        <item name="listPreferredItemHeightSmall">48dp</item>
        <item name="listPreferredItemPaddingLeft">16dp</item>
        <item name="listPreferredItemPaddingRight">16dp</item>
    </style>
    <style name="SmokyOverflowMenu" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/modern_overflow_background</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:overlapAnchor">false</item>
    </style>
    <style name="SmokyOverflowList" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">?attr/selectableItemBackground</item>
    </style>
    <style name="SmokyOverflowText" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
