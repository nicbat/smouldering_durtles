<resources>
    <attr name="smokyModernSearch" format="boolean"/>
    <!-- Scoped to result Views and the browsing toolbar, never the study activity. -->
    <style name="SmokySearchTheme" parent="SmokyMaterialTheme">
        <item name="smokyModernUi">true</item>
        <item name="wkTextColorPrimary">?attr/colorOnSurface</item>
        <item name="smokyModernSearch">true</item>
        <item name="viewInflaterClass">androidx.appcompat.app.AppCompatViewInflater</item>
        <item name="buttonStyle">@style/Widget.AppCompat.Button</item>
        <item name="colorBackground">?attr/colorSurface</item>
        <item name="tileColorBackground">?attr/colorSurfaceContainerLow</item>
        <item name="toolbarColorBackground">?attr/colorSurface</item>
    </style>
    <style name="SmokySearchBody" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="SmokySearchSupporting" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
