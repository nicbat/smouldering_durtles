<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="56dp"
    android:paddingTop="8dp" android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground" android:focusable="true">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="?attr/colorOnSurface"/>
        <TextView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textAppearance="@style/SmokySearchSupporting"/>
    </LinearLayout>
    <ImageView android:id="@+id/arrowHead" android:layout_width="48dp" android:layout_height="48dp"
        android:padding="12dp" android:importantForAccessibility="no"/>
</LinearLayout>
