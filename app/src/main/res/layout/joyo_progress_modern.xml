<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" android:text="@string/coverage_joyo_title"
        android:accessibilityHeading="true" android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="?attr/colorOnSurface"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" android:text="@string/coverage_explanation"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?attr/colorOnSurfaceVariant"/>
    <com.smouldering_durtles.wk.views.CoverageProgressRowView android:id="@+id/joyoGrade1Row"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <com.smouldering_durtles.wk.views.CoverageProgressRowView android:id="@+id/joyoGrade2Row"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <com.smouldering_durtles.wk.views.CoverageProgressRowView android:id="@+id/joyoGrade3Row"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <com.smouldering_durtles.wk.views.CoverageProgressRowView android:id="@+id/joyoGrade4Row"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <com.smouldering_durtles.wk.views.CoverageProgressRowView android:id="@+id/joyoGrade5Row"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <com.smouldering_durtles.wk.views.CoverageProgressRowView android:id="@+id/joyoGrade6Row"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <com.smouldering_durtles.wk.views.CoverageProgressRowView android:id="@+id/joyoGrade7Row"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</merge>
